{
  "name": "@local/ai-sidebar",
  "version": "0.1.0",
  "private": true,
  "description": "Independent embeddable Electron sidebar for Codex CLI and Claude Code",
  "main": "index.cjs",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "extract-zip": "2.0.1",
    "fzstd": "0.1.1",
    "tar": "6.2.1"
  },
  "scripts": {
    "start": "node scripts/start.cjs",
    "test:live": "node scripts/start.cjs --live-test",
    "test:live:smoke": "node scripts/start.cjs --live-showcase --real-token-suite",
    "test:live:categories": "node scripts/start.cjs --live-categories",
    "test:live:codex": "node scripts/start.cjs --live-codex-features",
    "test:live:plan": "node scripts/start.cjs --live-plan",
    "test:live:thread-tools": "node scripts/start.cjs --live-thread-tools",
    "test:live:queue": "node scripts/start.cjs --live-queue",
    "test": "node --test tests/*.test.cjs"
  },
  "files": [
    "src",
    "index.cjs",
    "licenses",
    "PROVENANCE.json",
    "docs",
    "standalone",
    "scripts"
  ],
  "devDependencies": {
    "acorn": "8.15.0",
    "electron": "34.5.8",
    "eslint-scope": "8.4.0",
    "postcss": "8.5.6",
    "postcss-selector-parser": "7.1.0"
  }
}
